# ============================================================
# AgriLink AI — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# --- Application ---
APP_NAME="AgriLink AI"
APP_VERSION="1.0.0"
ENVIRONMENT=development          # development | staging | production
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALLOWED_HOSTS=["*"]

# --- Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agrilink
POSTGRES_PASSWORD=agrilink_password
POSTGRES_DB=agrilink_db
DATABASE_URL=postgresql+asyncpg://agrilink:agrilink_password@localhost:5432/agrilink_db

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AWS S3 ---
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=agrilink-storage
AWS_S3_BASE_URL=https://agrilink-storage.s3.ap-south-1.amazonaws.com

# --- Email (SMTP) ---
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-email-password
MAIL_FROM=noreply@agrilink.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

# --- SMS (Twilio / placeholder) ---
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_FROM_NUMBER=+1234567890

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- AI Providers ---
AI_PROVIDER=openai           # openai | gemini | claude | mock
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-haiku-20240307

# --- Disease Detection ---
DISEASE_MODEL_PROVIDER=mock  # mock | tensorflow | pytorch | api
DISEASE_API_URL=https://your-disease-model-api.com

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Push Notifications ---
FCM_SERVER_KEY=your-fcm-server-key

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ============================================================
# KrishiSetu AI — Local Development .env
# ============================================================

# --- Application ---
APP_NAME="KrishiSetu AI"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=agrilink-dev-secret-key-change-in-production-32chars
ALLOWED_HOSTS=["*"]

# --- Database (SQLite Local DB / PostgreSQL) ---
# For instant zero-setup local running:
DATABASE_URL=sqlite+aiosqlite:///./agrilink.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://agrilink:agrilink_password@localhost:5432/agrilink_db


# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=agrilink-dev-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AWS S3 (Cloud Media Storage) ---
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-south-1
AWS_S3_BUCKET=agrilink-storage
AWS_S3_BASE_URL=https://agrilink-storage.s3.ap-south-1.amazonaws.com

# --- Email ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@agrilink.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

# --- SMS Gateway (Fast2SMS / Twilio) ---
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=your_fast2sms_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_FROM_NUMBER=+1234567890

# --- Razorpay Payment Gateway & Split Route ---
RAZORPAY_KEY_ID=rzp_live_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=whsec_agrilink_secret
RAZORPAY_ROUTE_ENABLED=true
PLATFORM_COMMISSION_PERCENTAGE=2.5

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- AI Providers ---
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Disease Detection ---
DISEASE_MODEL_PROVIDER=mock

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Push Notifications ---
FCM_SERVER_KEY=

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

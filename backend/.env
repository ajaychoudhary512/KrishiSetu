# ============================================================
# AgriLink AI — Local Development .env
# ============================================================

# --- Application ---
APP_NAME="AgriLink AI"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=agrilink-dev-secret-key-change-in-production-32chars
ALLOWED_HOSTS=["*"]

# --- Database (SQLite Local DB / PostgreSQL) ---
# For instant zero-setup local running:
DATABASE_URL=sqlite+aiosqlite:///./agrilink.db
# For production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://agrilink:agrilink_password@localhost:5432/agrilink_db


# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
JWT_SECRET_KEY=agrilink-dev-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- AWS S3 (leave empty — uses local storage in dev) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=agrilink-storage
AWS_S3_BASE_URL=https://agrilink-storage.s3.ap-south-1.amazonaws.com

# --- Email (leave empty — tasks just log in dev) ---
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@agrilink.ai
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TLS=true
MAIL_SSL=false

# --- SMS ---
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- AI Providers ---
AI_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Disease Detection ---
DISEASE_MODEL_PROVIDER=mock

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=20/minute

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# --- Push Notifications ---
FCM_SERVER_KEY=

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_rounded"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Header Drag Bar -->
    <View
        android:layout_width="48dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_indicator" />

    <TextView
        android:id="@+id/tvPurchaseDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/purchase_dialog_title"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <!-- Product Summary Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_input"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvPurchaseProductTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rice Straw Stubble"
            android:textColor="@color/text_main"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPurchaseAvailableStock"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available: 120 Quintal"
                android:textColor="@color/primary_green"
                android:textSize="13sp"
                android:fontFamily="sans-serif-medium"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPurchaseRate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹100 / Quintal"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quantity Input Field -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/enter_purchase_qty"
        android:textColor="@color/text_main"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPurchaseQty"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusTopStart="12dp"
        app:boxStrokeColor="@color/primary_green">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPurchaseQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="e.g. 20"
            android:inputType="numberDecimal"
            android:singleLine="true"
            android:textColor="@color/text_main"
            android:textSize="16sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Live Total Cost Summary Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_sage_badge"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="@string/total_cost_label"
            android:textColor="@color/text_main"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/tvPurchaseTotalCost"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="₹0.00"
            android:textColor="@color/primary_green"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelPurchase"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/cancel"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            app:cornerRadius="12dp"
            app:strokeColor="@color/border_light" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmPurchase"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1.5"
            android:text="@string/confirm_purchase_action"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_green"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_schemes_sheet"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="12dp"
    android:paddingEnd="22dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_indicator" />

    <!-- Header with Scheme Icon and Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/flDetailIconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_icon_green">

            <ImageView
                android:id="@+id/ivDetailSchemeIcon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:contentDescription="Scheme Icon"
                android:src="@drawable/ic_scheme_wheat"
                app:tint="@color/primary_green" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvDetailSchemeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="PM-Kisan Samman Nidhi"
                android:textColor="#1B2A1F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailSchemeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_badge_scheme_green"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="₹6,000/Year"
                android:textColor="@color/primary_green"
                android:textSize="11.5sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnDetailClose"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_close"
            android:clickable="true"
            android:contentDescription="Close Scheme Details"
            android:focusable="true">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#445548" />
        </FrameLayout>
    </LinearLayout>

    <!-- Scrollable Detailed Information -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:maxHeight="380dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Benefits -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="🎁 Benefits &amp; Assistance / लाभ एवं वित्तीय सहायता"
                android:textColor="#1B2A1F"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailBenefits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="2dp"
                android:text="• ₹6,000 per year transferred directly to bank accounts in 3 instalments of ₹2,000 each.\n• 100% centrally sponsored with Direct Benefit Transfer (DBT)."
                android:textColor="#445548"
                android:textSize="13sp" />

            <!-- Section 2: Eligibility -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="📋 Eligibility Criteria / पात्रता नियम"
                android:textColor="#1B2A1F"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailEligibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="2dp"
                android:text="• All landholding farmer families with cultivable land in their names.\n• Institutional landholders and high-income tax payees are excluded."
                android:textColor="#445548"
                android:textSize="13sp" />

            <!-- Section 3: Required Documents -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="📑 Required Documents / आवश्यक दस्तावेज़"
                android:textColor="#1B2A1F"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailDocuments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"
                android:lineSpacingExtra="2dp"
                android:text="• Aadhaar Card linked with active mobile number.\n• Bank Passbook (Aadhaar NPCI seeded).\n• Land Ownership Records (Khatauni / Khasra)."
                android:textColor="#445548"
                android:textSize="13sp" />

            <!-- Section 4: Application Information -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="🚀 How to Apply / आवेदन कैसे करें"
                android:textColor="#1B2A1F"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDetailHowToApply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="• Online: Visit pmkisan.gov.in -> Farmers Corner -> New Farmer Registration.\n• Offline: Visit nearest Common Service Center (CSC) or Agriculture Office."
                android:textColor="#445548"
                android:textSize="13sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions: Learn More / Helpline & Back -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailLearnMore"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="@color/primary_green"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Learn More / अधिक जानें"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_phone"
            app:iconGravity="textStart"
            app:iconTint="#FFFFFF" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetailDismiss"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:fontFamily="sans-serif-medium"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Back / वापस"
            android:textAllCaps="false"
            android:textColor="#445548"
            android:textSize="14sp"
            app:cornerRadius="14dp"
            app:strokeColor="#CBD8CE"
            app:strokeWidth="1dp" />
    </LinearLayout>

</LinearLayout>

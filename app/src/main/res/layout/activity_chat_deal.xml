<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app">

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/chatHeader"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBackChat"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_revert"
            android:tint="@color/text_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GreenPower Bio-Industries"
                android:textColor="@color/text_dark"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🟢 Industry Buyer • Online"
                android:textColor="@color/accent_green"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Escrow Banner -->
    <TextView
        android:id="@+id/escrowBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/chatHeader"
        android:background="@color/accent_light"
        android:gravity="center"
        android:padding="8dp"
        android:text="🛡️ KrishiSetu Escrow Protected • 2% Platform Mediator Fee"
        android:textColor="@color/primary_dark"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Chat Messages RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvChatMessages"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layoutDealCard"
        android:layout_below="@id/escrowBanner"
        android:padding="16dp" />

    <!-- Deal Card Overlay inside Chat -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutDealCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/chatInputBar"
        android:layout_margin="12dp"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/accent_green"
        app:strokeWidth="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤝 Official Escrow Deal Proposal"
                android:textColor="@color/primary_green"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="50 Quintals Rice Straw @ ₹1,150/Quintal"
                android:textColor="@color/text_dark"
                android:textSize="13sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="KrishiSetu Fee (2%): -₹1,150"
                    android:textColor="@color/primary_green"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="Net Payout: ₹56,350"
                    android:textColor="@color/primary_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAcceptEscrow"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:text="Accept Deal &amp; Lock in Escrow"
                android:backgroundTint="@color/accent_green"
                android:textColor="@color/primary_dark"
                android:textStyle="bold" />
        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom Chat Input Bar -->
    <LinearLayout
        android:id="@+id/chatInputBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <EditText
            android:id="@+id/etChatMessage"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@color/bg_app"
            android:hint="Type message..."
            android:paddingHorizontal="16dp"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendMessage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@color/primary_green"
            android:src="@android:drawable/ic_menu_send"
            android:tint="@color/white" />
    </LinearLayout>

</RelativeLayout>

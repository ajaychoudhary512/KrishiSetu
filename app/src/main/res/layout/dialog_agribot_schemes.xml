<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_modal_schemes_sheet"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="12dp"
    android:paddingEnd="20dp"
    android:paddingBottom="24dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="44dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_pill_indicator" />

    <!-- Header Area -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp">

        <!-- Robot / AgriBot Plant Icon Container -->
        <FrameLayout
            android:id="@+id/flHeaderIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_icon_green">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:contentDescription="AgriBot AI Icon"
                android:src="@drawable/ic_agribot"
                app:tint="@color/primary_green" />
        </FrameLayout>

        <!-- Title & Bilingual Subtitle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            android:layout_toStartOf="@id/btnCloseSchemesTop"
            android:layout_toEndOf="@id/flHeaderIcon"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvModalTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="AgriBot AI – Schemes &amp; Subsidies"
                android:textColor="#1B2A1F"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModalSubtitleEn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Government schemes &amp; financial support"
                android:textColor="#66736A"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvModalSubtitleHi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="किसानों के लिए सरकारी योजनाएँ और वित्तीय सहायता"
                android:textColor="#2E7D32"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Circular Close Button -->
        <FrameLayout
            android:id="@+id/btnCloseSchemesTop"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_close"
            android:clickable="true"
            android:contentDescription="Close Schemes Popup"
            android:focusable="true">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close"
                app:tint="#445548" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Scrollable Schemes Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CARD 1: PM-Kisan Samman Nidhi -->
            <LinearLayout
                android:id="@+id/cardSchemePmKisan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_scheme_green"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Left Circle Icon -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon_green">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="PM-Kisan Icon"
                        android:src="@drawable/ic_scheme_wheat"
                        app:tint="#2E7D32" />
                </FrameLayout>

                <!-- Middle Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title & Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="PM-Kisan Samman Nidhi"
                            android:textColor="#1B2A1F"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_scheme_green"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="₹6,000/Year"
                            android:textColor="#2E7D32"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- English Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Direct income support to farmers (₹6,000 per year in 3 instalments)"
                        android:textColor="#4B5950"
                        android:textSize="12.5sp" />

                    <!-- Hindi Translation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="किसानों को प्रतिवर्ष ₹6,000 की सीधी आर्थिक सहायता"
                        android:textColor="#2E7D32"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Right Chevron -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Open Details"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="#7F9185" />
            </LinearLayout>

            <!-- CARD 2: PM Fasal Bima Yojana -->
            <LinearLayout
                android:id="@+id/cardSchemeFasalBima"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_scheme_blue"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Left Circle Icon -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon_blue">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="PMFBY Crop Insurance"
                        android:src="@drawable/ic_scheme_shield"
                        app:tint="#1565C0" />
                </FrameLayout>

                <!-- Middle Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title & Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="PM Fasal Bima Yojana"
                            android:textColor="#1B2A1F"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_scheme_blue"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="Crop Insurance"
                            android:textColor="#1565C0"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- English Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Crop insurance and compensation for crop loss due to natural calamities"
                        android:textColor="#4B5950"
                        android:textSize="12.5sp" />

                    <!-- Hindi Translation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="फसल बीमा और प्राकृतिक आपदाओं से फसल नुकसान पर मुआवजा"
                        android:textColor="#1565C0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Right Chevron -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Open Details"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="#7F9185" />
            </LinearLayout>

            <!-- CARD 3: Kisan Credit Card (KCC) -->
            <LinearLayout
                android:id="@+id/cardSchemeKcc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_card_scheme_amber"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Left Circle Icon -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon_amber">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="Kisan Credit Card"
                        android:src="@drawable/ic_scheme_kcc"
                        app:tint="#E65100" />
                </FrameLayout>

                <!-- Middle Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title & Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Kisan Credit Card (KCC)"
                            android:textColor="#1B2A1F"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_scheme_amber"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="Low Interest"
                            android:textColor="#E65100"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- English Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Concessional credit for agricultural and allied activities"
                        android:textColor="#4B5950"
                        android:textSize="12.5sp" />

                    <!-- Hindi Translation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="कृषि एवं संबद्ध गतिविधियों के लिए कम ब्याज दर पर ऋण"
                        android:textColor="#BF4700"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Right Chevron -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Open Details"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="#7F9185" />
            </LinearLayout>

            <!-- CARD 4: Agricultural Equipment & Solar Pumps -->
            <LinearLayout
                android:id="@+id/cardSchemeSubsidies"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_card_scheme_purple"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <!-- Left Circle Icon -->
                <FrameLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_icon_purple">

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:layout_gravity="center"
                        android:contentDescription="Equipment Subsidy Icon"
                        android:src="@drawable/ic_scheme_machinery"
                        app:tint="#6A1B9A" />
                </FrameLayout>

                <!-- Middle Content -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Title & Badge Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="sans-serif-medium"
                            android:text="Subsidies on Machinery &amp; Solar"
                            android:textColor="#1B2A1F"
                            android:textSize="14.5sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_badge_scheme_purple"
                            android:fontFamily="sans-serif-medium"
                            android:paddingStart="8dp"
                            android:paddingTop="3dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="3dp"
                            android:text="Subsidy Support"
                            android:textColor="#6A1B9A"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- English Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:lineSpacingExtra="1dp"
                        android:text="Financial assistance for farm machinery, solar pumps and modern equipment"
                        android:textColor="#4B5950"
                        android:textSize="12.5sp" />

                    <!-- Hindi Translation -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="1dp"
                        android:text="कृषि मशीनरी, सोलर पंप और आधुनिक उपकरणों पर सब्सिडी"
                        android:textColor="#6A1B9A"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Right Chevron -->
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Open Details"
                    android:src="@drawable/ic_arrow_forward"
                    app:tint="#7F9185" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Button: Close / बंद करें -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseSchemesBottom"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="4dp"
        android:backgroundTint="@color/primary_green"
        android:fontFamily="sans-serif-medium"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:text="Close / बंद करें"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="15.5sp"
        android:textStyle="bold"
        app:cornerRadius="16dp"
        app:elevation="2dp" />

</LinearLayout>

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme: KRISHISETU Nature Agriculture (Light) -->
    <style name="Theme.AgriLink" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Green -->
        <item name="colorPrimary">@color/primary_green</item>
        <item name="colorPrimaryVariant">@color/deep_green</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary Green -->
        <item name="colorSecondary">@color/secondary_green</item>
        <item name="colorSecondaryVariant">@color/light_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Accent Harvest Orange -->
        <item name="colorTertiary">@color/harvest_orange</item>
        <item name="colorOnTertiary">@color/white</item>

        <!-- Surfaces and Backgrounds -->
        <item name="android:windowBackground">@color/soft_background</item>
        <item name="colorSurface">@color/white</item>
        <item name="colorOnSurface">@color/text_main</item>

        <!-- Status bar & Navigation bar -->
        <item name="android:statusBarColor">@color/deep_green</item>
        <item name="android:navigationBarColor">@color/soft_background</item>
        <item name="android:windowLightStatusBar">false</item>

        <!-- Typography & Text colors -->
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="editTextColor">@color/text_main</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Bottom Navigation Style -->
        <item name="bottomNavigationStyle">@style/Widget.KrishiSetu.BottomNav</item>
    </style>

    <style name="Theme.AgriLink.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Bottom Navigation Styling -->
    <style name="Widget.KrishiSetu.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@color/white</item>
        <item name="itemIconTint">@color/selector_bottom_nav</item>
        <item name="itemTextColor">@color/selector_bottom_nav</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.KrishiSetu.BottomNavIndicator</item>
        <item name="elevation">8dp</item>
    </style>

    <style name="Widget.KrishiSetu.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/light_green</item>
    </style>

    <!-- Primary Button Style -->
    <style name="Widget.KrishiSetu.Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary_green</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Accent Button Style -->
    <style name="Widget.KrishiSetu.Button.Accent" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/harvest_orange</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">@dimen/radius_medium</item>
        <item name="android:minHeight">@dimen/min_touch_target</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Nature Card Style -->
    <style name="Widget.KrishiSetu.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/radius_card</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@android:color/transparent</item>
    </style>
</resources>
